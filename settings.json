  // =========================
  // EDITOR UI MINIMALISM
  // =========================
  "breadcrumbs.enabled": false,
  "editor.minimap.enabled": false,
  "workbench.editor.editorActionsLocation": "hidden",
  "window.commandCenter": false,
  "workbench.layoutControl.enabled": false,
  "window.density.editorTabHeight": "compact",
  "workbench.sideBar.location": "right",
  "workbench.activityBar.location": "bottom",
  "editor.showFoldingControls": "never",
  "editor.renderLineHighlight": "gutter",
  "workbench.tree.indent": 16,
  "workbench.tree.renderIndentGuides": "always",

  // =========================
  // FONT — Geist Mono everywhere
  // =========================
  "editor.fontFamily": "'Geist Mono', 'JetBrains Mono', monospace",
  "editor.fontLigatures": true,
  "editor.fontSize": 14,
  "editor.lineHeight": 1.7,
  "editor.letterSpacing": 0.2,
  "terminal.integrated.fontFamily": "'Geist Mono', monospace",
  "terminal.integrated.fontSize": 13,
  "terminal.integrated.lineHeight": 1.5,
  "debug.console.fontFamily": "'Geist Mono', monospace",
  "scm.inputFontFamily": "'Geist Mono', monospace",
  "chat.editor.fontFamily": "'Geist Mono', monospace",
  "editor.inlayHints.fontFamily": "'Geist Mono', monospace",
  "markdown.preview.fontFamily": "'Geist Mono', monospace",

  // =========================
  // SCROLLBAR — thin & smooth
  // =========================
  "editor.scrollbar.verticalScrollbarSize": 6,
  "editor.scrollbar.horizontalScrollbarSize": 6,
  "editor.scrollbar.vertical": "visible",
  "editor.scrollbar.horizontal": "visible",

  // =========================
  // APC CUSTOMIZE UI
  // =========================
  "apc.electron": {
    "backgroundColor": "#060606",
    "frame": true,
    "transparent": true,
    "titleBarStyle": "hiddenInset",
    "vibrancy": "ultra-dark",
    "trafficLightPosition": { "x": 15, "y": 13 },
    "trafficLightPositionRight": { "x": 15, "y": 13 }
  },
  "apc.font.family": "'Geist Mono', monospace",
  "apc.header": {
    "compact": 22,
    "fontSize": 12,
    "fontWeight": "normal"
  },
  "apc.sidebar.titlebar": {
    "fontSize": 11,
    "fontWeight": "normal"
  },
  "apc.menubar.compact": true,
  "apc.stylesheet": {

    // ── Tabs: rounded top corners ─────────────────
    ".tabs-container .tab": {
      "border-radius": "10px 10px 0 0 !important",
      "margin-top": "3px !important",
      "margin-right": "2px !important"
    },
    ".tabs-container .tab.active": {
      "border-radius": "10px 10px 0 0 !important",
      "background": "#0a0a0a !important"
    },

    // ── Buttons: amber, 0.75rem radius ───────────
    ".monaco-button": {
      "border-radius": "10px !important",
      "padding": "5px 16px !important",
      "font-family": "'Geist Mono', monospace !important"
    },

    // ── Inputs: soft radius ───────────────────────
    ".monaco-inputbox": {
      "border-radius": "10px !important"
    },
    ".monaco-inputbox .input": {
      "border-radius": "10px !important"
    },

    // ── Suggest widget ────────────────────────────
    ".monaco-editor .suggest-widget": {
      "border-radius": "12px !important",
      "border": "1px solid #2a2a2a !important",
      "box-shadow": "0 8px 32px rgba(0,0,0,0.7) !important",
      "overflow": "hidden !important"
    },

    // ── Command palette ───────────────────────────
    ".quick-input-widget": {
      "border-radius": "14px !important",
      "border": "1px solid #2a2a2a !important",
      "box-shadow": "0 16px 60px rgba(0,0,0,0.8) !important",
      "overflow": "hidden !important"
    },

    // ── Context menus ─────────────────────────────
    ".context-view .monaco-menu": {
      "border-radius": "10px !important",
      "border": "1px solid #2a2a2a !important",
      "box-shadow": "0 8px 28px rgba(0,0,0,0.7) !important",
      "overflow": "hidden !important"
    },

    // ── Hover docs ────────────────────────────────
    ".monaco-editor .monaco-hover": {
      "border-radius": "10px !important",
      "border": "1px solid #2a2a2a !important",
      "box-shadow": "0 4px 20px rgba(0,0,0,0.6) !important",
      "overflow": "hidden !important"
    },

    // ── Badges: pill ──────────────────────────────
    ".monaco-count-badge": {
      "border-radius": "999px !important",
      "padding": "1px 7px !important",
      "font-family": "'Geist Mono', monospace !important"
    },

    // ── Scrollbar ─────────────────────────────────
    ".scrollbar": {
      "background": "#060606 !important"
    },
    ".scrollbar .slider": {
      "border-radius": "6px !important"
    },

    // ── Notification toasts ───────────────────────
    ".notifications-list-container .notification-toast": {
      "border-radius": "12px !important",
      "border": "1px solid #2a2a2a !important",
      "box-shadow": "0 8px 32px rgba(0,0,0,0.7) !important"
    },

    // ── Keybinding chips ──────────────────────────
    ".monaco-keybinding-key": {
      "border-radius": "6px !important",
      "font-family": "'Geist Mono', monospace !important"
    }
  },

  // =========================
  // COPILOT
  // =========================
  "github.copilot.chat.terminalChatLocation": "terminal",

  // =========================
  // LANGUAGE SETTINGS
  // =========================
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },

  // =========================
